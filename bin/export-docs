#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "yaml"

root = Pathname.new(__dir__).parent
output = root.join("site/generated")
manifest_path = output.join("manifest.json")
config_path = root.join("site/publication.yml")
options = {}
OptionParser.new do |parser|
  parser.banner = "Usage: bin/export-docs --source VAULT_DOCS [--revision COMMIT] [--check] | --verify"
  parser.on("--source PATH") { |value| options[:source] = Pathname.new(value).expand_path }
  parser.on("--revision COMMIT") { |value| options[:revision] = value }
  parser.on("--check") { options[:check] = true }
  parser.on("--verify") { options[:verify] = true }
end.parse!
abort "Use --source VAULT_DOCS or --verify" unless options[:source] || options[:verify]
abort "--verify cannot be combined with other options" if options[:verify] && options.size > 1

pages = YAML.safe_load_file(config_path).fetch("pages")
paths = pages.map { |page| page.fetch("source") }
routes = pages.map { |page| page.fetch("permalink") }
abort "Invalid publication paths" unless paths.all? { |path| path.match?(/\A[a-z_\-]+\.md\z/) }
abort "Invalid publication routes" unless routes.all? { |route| route.match?(/\A\/(?:[a-z-]+\/)?\z/) }
abort "Duplicate publication path or route" unless paths.uniq == paths && routes.uniq == routes
fingerprints = {
  "schema" => 1,
  "exporter_sha256" => Digest::SHA256.file(__FILE__).hexdigest,
  "config_sha256" => Digest::SHA256.file(config_path).hexdigest
}

if options[:verify]
  manifest = JSON.parse(manifest_path.read)
  abort "Exporter or allowlist changed; regenerate the snapshot" unless fingerprints.all? { |key, value| manifest[key] == value }
  abort "Invalid vault revision" unless manifest.fetch("source_revision").match?(/\A[0-9a-f]{40}\z/)
  abort "Manifest does not match the allowlist" unless manifest.fetch("files").keys == paths
  manifest.fetch("files").each do |name, record|
    abort "Invalid source hash: #{name}" unless record.fetch("source_sha256").match?(/\A[0-9a-f]{64}\z/)
    path = output.join(name)
    abort "Missing or modified generated page: #{name}" unless path.file? && !path.symlink? && Digest::SHA256.file(path).hexdigest == record.fetch("output_sha256")
  end
  expected = (paths + ["manifest.json"]).sort
  actual = output.children.map { |path| path.basename.to_s }.sort
  abort "Unexpected generated files" unless actual == expected
  puts "Verified #{paths.size} publication pages and manifest."
  exit
end

git = lambda do |*args|
  stdout, stderr, status = Open3.capture3("git", "-C", options.fetch(:source).to_s, *args)
  abort "Cannot read canonical source: #{stderr.strip}" unless status.success?
  stdout
end
vault = Pathname.new(git.call("rev-parse", "--show-toplevel").strip)
relative_source = options.fetch(:source).relative_path_from(vault)
previous = JSON.parse(manifest_path.read) if options[:check]
revision = options[:revision] || previous&.fetch("source_revision") || "HEAD"
revision = git.call("rev-parse", "--verify", "#{revision}^{commit}").strip
manifest = fingerprints.merge("source_revision" => revision, "source_root" => relative_source.to_s, "files" => {})
route_map = pages.to_h { |page| [page.fetch("source"), page.fetch("permalink")] }
rendered = {}

pages.each_with_index do |page, index|
  name = page.fetch("source")
  path = options.fetch(:source).join(name)
  abort "Missing or symlinked source: #{name}" unless path.file? && !path.symlink?
  source = git.call("show", "#{revision}:#{relative_source}/#{name}")
  abort "#{name} differs from vault revision #{revision}; commit the canonical changes first" unless path.read == source
  body = source.sub(/\A---\r?\n.*?\r?\n---\r?\n/m, "").strip
  body = body.gsub(/<!-- public-docs:omit:start -->.*?<!-- public-docs:omit:end -->\s*/m, "")
  abort "Unbalanced private section in #{name}" if body.include?("<!-- public-docs:omit:")
  abort "Unresolved vault link in #{name}" if body.match?(/\[\[(?:products|organization)\//)
  abort "Source Liquid is not supported in #{name}" if body.include?("{{") || body.include?("{\%")
  body = body.gsub(/\]\(([a-z_\-]+\.md)(#[^)]+)?\)/) do
    route = route_map.fetch(Regexp.last_match(1)) { abort "Unpublished link in #{name}: #{Regexp.last_match(1)}" }
    "]({{ '#{route}' | relative_url }}#{Regexp.last_match(2)})"
  end
  metadata = {
    "layout" => "default", "title" => page.fetch("title"), "nav_order" => index,
    "permalink" => page.fetch("permalink")
  }
  text = "#{YAML.dump(metadata)}---\n\n<!-- Generated by bin/export-docs. Edit the canonical vault source. -->\n\n#{body}\n"
  rendered[name] = text
  manifest["files"][name] = { "source_sha256" => Digest::SHA256.hexdigest(source), "output_sha256" => Digest::SHA256.hexdigest(text) }
end
rendered["manifest.json"] = "#{JSON.pretty_generate(manifest)}\n"

if options[:check]
  actual = output.children.map { |path| path.basename.to_s }.sort
  abort "Generated file list has drifted" unless actual == rendered.keys.sort
  drift = rendered.keys.reject { |name| output.join(name).file? && output.join(name).read == rendered[name] }
  abort "Publication drift: #{drift.join(', ')}; regenerate with bin/export-docs" unless drift.empty?
  puts "No publication drift against vault revision #{revision}."
else
  FileUtils.mkdir_p(output)
  output.children.each { |path| FileUtils.rm(path) if path.file? && !rendered.key?(path.basename.to_s) }
  rendered.each { |name, text| output.join(name).write(text) }
  puts "Exported #{pages.size} pages from vault revision #{revision}."
end
