#!/usr/bin/env bash
# bin/ci — Local CI pipeline. Run before committing or opening a PR.
# Usage: bin/ci
set -e

PASS=0
FAIL=0
SKIP=0

step() {
  local name="$1"; shift
  printf "\n\033[1;34m→ %s\033[0m\n" "$name"
  if "$@" 2>&1; then
    printf "\033[1;32m  ✓ %s\033[0m\n" "$name"
    PASS=$((PASS + 1))
  else
    printf "\033[1;31m  ✗ %s\033[0m\n" "$name"
    FAIL=$((FAIL + 1))
  fi
}

skip() {
  local name="$1"
  printf "\n\033[1;33m⊘ %s (skipped — not installed)\033[0m\n" "$name"
  SKIP=$((SKIP + 1))
}

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔍 Local CI — $(basename "$(pwd)")"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Dependency check/install.
step "Setup: Bundle check" bundle check

# Tests: matches GitHub CI for this engine.
step "Tests: Rake" env COVERAGE=true bundle exec rake test

# Optional security/static checks if the repo has them installed later.
if bundle exec brakeman --version >/dev/null 2>&1; then
  step "Security: Brakeman" bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error
else
  skip "Security: Brakeman"
fi

if bundle exec bundler-audit --version >/dev/null 2>&1; then
  step "Security: Bundle audit" bundle exec bundler-audit check --update
else
  skip "Security: Bundle audit"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ "$FAIL" -eq 0 ]; then
  printf "\033[1;32m✅ CI passed — %d steps passed" "$PASS"
else
  printf "\033[1;31m❌ CI failed — %d passed, %d failed" "$PASS" "$FAIL"
fi
[ "$SKIP" -gt 0 ] && printf ", %d skipped" "$SKIP"
printf "\033[0m\n"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

[ "$FAIL" -eq 0 ] && exit 0 || exit 1
